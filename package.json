{
  "name": "board-online",
  "private": true,
  "version": "0.1.0",
  "description": "무료 온라인 보드게임 플랫폼 MVP - 오목, 체스, 장기, 체커, 리버시",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @board-online/server",
    "dev:client": "npm run dev -w @board-online/client",
    "build": "npm run build -w @board-online/client",
    "start": "npm run start -w @board-online/server",
    "test:engine": "npm run test:engine -w @board-online/shared"
  },
  "engines": {
    "node": ">=18"
  }
}
